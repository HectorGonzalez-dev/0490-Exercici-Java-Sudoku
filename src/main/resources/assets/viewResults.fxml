<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchor" minHeight="500.0" minWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clientFX.CtrlResults">
   <children>
      <VBox alignment="TOP_CENTER" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <Label alignment="CENTER" maxWidth="Infinity" text="Resultats">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <VBox fx:id="rankingBox" alignment="CENTER" spacing="5.0" />
            <Button mnemonicParsing="false" onAction="#playAgain" text="Tornar a jugar" />
         </children>
      </VBox>
   </children>
</AnchorPane>
