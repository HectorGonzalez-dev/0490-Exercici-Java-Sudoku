<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchor" minHeight="600.0" minWidth="700.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clientFX.CtrlSudoku">
   <children>
      <VBox alignment="TOP_CENTER" spacing="8.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <Label alignment="CENTER" maxWidth="Infinity" text="Sudoku">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <Label fx:id="lblPlayer" text="[TU] ..." />
            <HBox alignment="CENTER" spacing="40.0">
               <children>
                  <GridPane fx:id="sudokuGrid" alignment="CENTER" hgap="0.0" vgap="0.0" />
                  <VBox alignment="TOP_CENTER" spacing="10.0">
                     <children>
                        <Label text="Número:" />
                        <GridPane fx:id="numberBox" alignment="CENTER" hgap="5.0" vgap="5.0" />
                        <Label alignment="CENTER_RIGHT" maxWidth="Infinity" text="Ranking">
                           <font>
                              <Font size="16.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Label>
                        <VBox fx:id="playersBox" alignment="CENTER_RIGHT" spacing="2.0" />
                     </children>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            <Label fx:id="lblStatus" text="" wrapText="true" />
         </children>
      </VBox>
   </children>
</AnchorPane>
